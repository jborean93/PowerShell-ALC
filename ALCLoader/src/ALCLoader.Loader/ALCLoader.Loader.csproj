<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
    The loader is only used on PowerShell 7, WinPS loads ALCLoader.dll
    directly as it has no concept of an ALC.
    -->
    <TargetFrameworks>net5.0</TargetFrameworks>
    <!--Not needed but makes it nicer to write in C# at this version-->
    <LangVersion>10.0</LangVersion>
    <!--Not needed but using Nullable is highly recommended-->
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net5.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net5.0' ">
    <!--
    For PowerShell 7 we can load S.M.A at the version desired. This allows us
    to use newer features with preprocessor directives. The PrivateAssets must
    be set to all as PowerShell provides these assets at runtime. The runtime
    assets are also excluded so S.M.A is not listed in ALCLoader.deps.json
    and the ALC falls back to the copy PowerShell has already loaded.
    -->
    <PackageReference Include="System.Management.Automation" Version="7.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <!--
    References the loader so it is published alongside our module. It is
    only needed on PowerShell 7.
    -->
    <ProjectReference Include="../ALCLoader.Loader/ALCLoader.Loader.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <!--
    For PowerShell 5.1 we reference the standard library which provides a
    baseline API for WinPS 5.1 and PS 7+. The PrivateAssets must also be set
    to all as PowerShell provides them at runtime.
    -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
    Any dep we reference here is listed in ALCLoader.deps.json and will
    automatically be loaded in our ALC. Do not set PrivateAssets="all" on a
    dep that should be bundled, the SDK will not publish it.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>
</Project>
